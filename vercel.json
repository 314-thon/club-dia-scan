{
  "rewrites": [
    { "source": "/api/catalog", "destination": "/api/catalog" },
    { "source": "/api/dia/:path*", "destination": "/api/dia?path=:path*" },
    {
      "source": "/((?!api/|assets/|catalog\\.json|manifest\\.webmanifest|sw\\.js|icon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
